# Minimal .env.example for Maneuver
# Copy to .env and fill in your values. Never commit .env to git.

# App branding
VITE_APP_NAME="Your Scouting App"
VITE_APP_URL="https://scouting.team1676.org"
VITE_ACCENT_COLOR="#FFCC00"

# Logo/favicon paths (relative to /public)
VITE_LOGO_PATH="/pioneer.png"
VITE_FAVICON_PATH="/pioneer.png"

# Google OAuth
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
VITE_GOOGLE_REDIRECT_URI="https://scouting.team1676.org/auth/google/callback"
GOOGLE_OAUTH_CLIENT_SECRET="your-secret-here"

# Access control
VITE_GOOGLE_ADMIN_EMAIL="admin@yourteam.com"
VITE_ALLOWED_EMAIL_DOMAIN="yourteam.org"

# API endpoints
VITE_API_BASE_URL="https://api.team1676.org/scouting"
VITE_TBA_API_KEY=""
VITE_DISABLE_ANALYTICS=false
VITE_VAPID_PUBLIC_KEY="your-public-vapid-key"

# Backend CORS (server-side only)
CORS_ORIGIN="https://scouting.team1676.org,https://api.team1676.org,http://localhost:4176"
API_BASE_PATH="/scouting"
EXTRA_API_PREFIXES="/api"

# Web push (server-side only)
VAPID_PUBLIC_KEY="your-public-vapid-key"
VAPID_PRIVATE_KEY="your-private-vapid-key"
VAPID_CONTACT_EMAIL="scouting@yourteam.com"

# Match reminder notifications
MATCH_NOTIFICATION_LOOKAHEAD=5
VITE_MATCH_NOTIFICATION_LOOKAHEAD=5

# Form Maker defaults (shared by frontend + backend)
VITE_FORM_DB_HOST="db.yourteam.com"
FORM_DB_PORT=3306

# Encrypts stored form database passwords (server-side)
FORM_DB_SECRET="change_me_to_a_long_random_string"

# Signs the backend's own session tokens (POST /auth/session). If unset, a
# random per-boot secret is used and server restarts invalidate all access
# tokens (clients silently re-auth via refresh tokens).
AUTH_JWT_SECRET="change_me_to_a_different_long_random_string"

# Backend database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maneuver
DB_USER=root
DB_PASSWORD=your_password_here

# Optional: override full Prisma connection string
# DATABASE_URL="mysql://user:pass@host:3306/maneuver"
