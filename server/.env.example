# Backend database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maneuver
DB_USER=root
DB_PASSWORD=your_password_here

# Optional: override full Prisma connection string
# DATABASE_URL="mysql://user:pass@host:3306/maneuver"

# Encrypts stored form database passwords (server-side)
FORM_DB_SECRET="change_me_to_a_long_random_string"

# Signs the app's own session tokens (issued by POST /auth/session).
# If unset, a random per-boot secret is used and every server restart
# invalidates all access tokens (clients then silently re-auth via their
# refresh tokens). Set it to keep sessions across restarts.
AUTH_JWT_SECRET="change_me_to_a_different_long_random_string"
